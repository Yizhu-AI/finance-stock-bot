# Copy this file to .env and fill in your real values. Never commit .env.

FINNHUB_API_KEY=your_finnhub_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated tickers to track
WATCHLIST=AAPL,TSLA,NVDA

# Total simulated paper-trading capital, split evenly across WATCHLIST
SIM_STARTING_CAPITAL=10000

# Seconds to wait between tickers so a multi-ticker watchlist doesn't
# exceed Gemini's free-tier rate limit (15 requests/min) within one run.
# Each ticker runs up to 4 Gemini calls (technical analyst, news analyst,
# coordinator, critic).
LLM_REQUEST_DELAY_SECONDS=15

# Seconds to wait between each pair of a ticker's own Gemini calls, so one
# ticker's own requests don't burst out back-to-back
INTRA_TICKER_REQUEST_DELAY_SECONDS=2

# Total autonomous tool calls allowed across the ENTIRE run (every ticker,
# every specialist combined) — bounds worst-case aggregate cost/latency
# when several tickers are genuinely ambiguous. Default: 2 * len(WATCHLIST)
# GLOBAL_TOOL_CALL_BUDGET=20
